# Environment Configuration
NODE_ENV=production
PORT=3000

# Base URL (will be set by deployment platform)
BASE_URL=https://your-app-name.onrender.com

# Email Configuration (for email verification)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Security Configuration
JWT_SECRET=change-this-to-a-long-random-string
SESSION_SECRET=change-this-to-another-long-random-string
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-this-on-first-login
DEFAULT_ADMIN_EMAIL=admin@votesphere.com

MAX_VOTES_PER_IP=10
RATE_LIMIT_WINDOW=60000
MAX_REQUESTS_PER_MINUTE=20
EMAIL_VERIFICATION_REQUIRED=false

# Optional: Database URL (if switching to PostgreSQL later)
# DATABASE_URL=postgresql://username:password@hostname:port/database